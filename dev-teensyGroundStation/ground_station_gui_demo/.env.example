# Copy this file to .env and fill in real values. .env is gitignored -
# never commit real credentials.

# SMTP - for Gmail: smtp.gmail.com, port 465, SMTP_USE_SSL=true, and an
# app password (not your regular password) for SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_NAME=
SMTP_FROM_EMAIL=

# Subject line for the outreach email.
EMAIL_SUBJECT=

# Linked in the email body.
PROJECT_WEBSITE_URL=
